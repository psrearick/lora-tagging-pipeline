{
    "extractor": {
        "reddit": {
            "parent-skip": true,
            "directory": ["{subreddit}"],
            "image-filter": "width >= 1024 and height >= 1024",
            "metadata": true,
            "recursion": 0,
            "parent-directory": true,
            "parent-metadata": "_reddit",
            "filename": "{score:>06}_{id}.{extension}"
        },
        "imgur": {
            "directory": {
                "_reddit": []
            }
        }
    },
    "downloader": {
        "part": false,
        "retries": 3
    }
}
